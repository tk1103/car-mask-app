# Gemini
GEMINI_API_KEY=
GEMINI_DETECT_MODEL=gemini-2.5-flash

# Site / @press（本番必須）
NEXT_PUBLIC_SITE_URL=https://auto-mobile-camera.vercel.app
NEXT_PUBLIC_OPERATOR_NAME=運営者名または屋号
NEXT_PUBLIC_CONTACT_EMAIL=info@rialtoweb.com

# 運営者デバイス（β中も Pro・AI検出無制限）。localStorage の carkus_device_id をカンマ区切りで指定
# PRO_DEVICE_IDS=
# PRO_DAILY_DETECT_LIMIT=0

# 課金（β公開時は設定しない = 無料版のみ。PRO_DEVICE_IDS は課金なしでも有効）
# BILLING_ENABLED=true

# Metrics（任意）
# Upstash 連携時は KVRESTAPI_* も入るが、コードは KV_REST_API_* を参照
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# METRICS_ADMIN_TOKEN=
